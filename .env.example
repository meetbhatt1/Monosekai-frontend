# Backend API origin INCLUDING /api (no trailing slash).
# Expo Go on a real device cannot use localhost — use your machine LAN IP, or
# leave this unset and the app will derive the host from Expo Metro automatically.
#
# Examples:
#   EXPO_PUBLIC_API_BASE_URL=http://10.150.110.22:8000/api
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api   # iOS Simulator / web only
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
